# ─────────────────────────────────────────────────────────────
# Salon Template — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file to ".env"
# 2. Replace every placeholder value with your own
# 3. NEVER commit your real .env to a public repo
#
# All variables MUST be prefixed with VITE_ to be exposed to the
# client bundle by Vite.
# ─────────────────────────────────────────────────────────────

# Turso (SQLite-compatible hosted DB)
# 1. Install Turso CLI:  npm install -g @turso/cli
# 2. Create a DB:        turso db create salon-db
# 3. Get URL:            turso db show salon-db --url
# 4. Get token:          turso db tokens create salon-db
VITE_TURSO_DB_URL="libsql://your-db-name-your-region.turso.io"
VITE_TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# Admin credentials for local auth (used to log into the dashboard)
# Change these to strong, unique values before deploying.
VITE_ADMIN_EMAIL="admin@example.com"
VITE_ADMIN_PASSWORD="change-me-to-a-strong-password"

# Salon WhatsApp number for booking confirmations
# Use local format without the country code or "+" (e.g. 0712345678)
VITE_WHATSAPP_NUMBER="0712345678"
